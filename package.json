{
  "name": "aicte-security-deposit-portal",
  "version": "1.0.0",
  "private": true,
  "description": "AICTE Security Deposit & FDR Management Portal — Regulation Bureau",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:export-demo": "node --env-file=.env.local scripts/export-demo-documents.mjs",
    "db:setup": "drizzle-kit push --force && tsx --env-file=.env.local src/db/seed.ts",
    "db:reset": "drizzle-kit push --force && tsx --env-file=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@hookform/resolvers": "^6.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
