{
  "name": "aicte-security-deposit-portal",
  "version": "1.0.0",
  "private": true,
  "description": "AICTE Security Deposit & FDR Management Portal — Regulation Bureau",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:setup": "drizzle-kit push --force && tsx --env-file=.env.local src/db/seed.ts",
    "db:reset": "drizzle-kit push --force && tsx --env-file=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
