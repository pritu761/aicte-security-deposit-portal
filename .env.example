# PostgreSQL — local development or a Neon pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/aicte_fdr
DATABASE_SSL=false
# Force the Neon WebSocket driver even when the URL does not contain "neon".
# DATABASE_DRIVER=neon

# 32-byte base64 secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
DOCUMENT_ENCRYPTION_KEY=
CRON_SECRET=

# Optional
# APP_URL=http://localhost:3000
# DATABASE_POOL_MAX=5
